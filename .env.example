# الگوی متغیرهای محیطی — کپی به .env برای توسعه محلی
# روی Netlify این مقادیر از Site configuration > Environment variables تنظیم می‌شوند.

# اتصال PostgreSQL (مثلاً Neon / Supabase / ElephantSQL)
DATABASE_URL="postgresql://user:password@host:5432/app_db?sslmode=require"

# اختیاری: دامنه رسمی سایت (برای sitemap/robots و لینک گزارش‌ها)
# NEXT_PUBLIC_SITE_URL="https://your-site.netlify.app"
